{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "EXPO_PUBLIC_DEMO_MEDIA=1 EXPO_NO_DOTENV=1 EXPO_OFFLINE=1 CI=1 npx expo export --dev --platform web --output-dir dist-preview && node scripts/preview-routes.mjs dist-preview",
  "outputDirectory": "dist-preview",
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": {
      "dependabot/*": false
    }
  },
  "rewrites": [
    {
      "source": "/c/:code",
      "destination": "/c/_code"
    },
    {
      "source": "/r/:code",
      "destination": "/r/_code"
    },
    {
      "source": "/day/:date",
      "destination": "/day/_date"
    },
    {
      "source": "/exercise/:id",
      "destination": "/exercise/_id"
    },
    {
      "source": "/movement-pain/:id",
      "destination": "/movement-pain/_id"
    },
    {
      "source": "/rehab/:id",
      "destination": "/rehab/_id"
    },
    {
      "source": "/program/:id",
      "destination": "/program/_id"
    },
    {
      "source": "/repair/test/:key",
      "destination": "/repair/test/_key"
    },
    {
      "source": "/workout/:id",
      "destination": "/workout/_id/index"
    },
    {
      "source": "/workout/:id/:screen",
      "destination": "/workout/_id/:screen"
    }
  ]
}
