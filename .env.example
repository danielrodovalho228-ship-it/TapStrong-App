# Copy to .env and fill in. Never commit .env.
# Only EXPO_PUBLIC_* variables are bundled into the app. They must be public-safe.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side secrets are NOT set here. Store them as Supabase secrets:
#   npx supabase secrets set ANTHROPIC_API_KEY=...
# Optional: web domain for invite links (https://tapstrong.app once it is set up).
# Without it, invite links use the app scheme: tapstrong://r/CODE
EXPO_PUBLIC_SHARE_BASE_URL=
# RevenueCat PUBLIC SDK keys (Project settings → API keys → public app-specific keys).
# The secret key never goes here: it is a Supabase secret (REVENUECAT_SECRET_KEY).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# PostHog (product events) and Sentry (crashes): public keys only, both optional.
# Leave empty and nothing is sent. Nothing is ever sent from a child profile.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
# Store pages, once published (round 2): links on the web's "mobile app"
# notes. Only https://apps.apple.com/... and https://play.google.com/...
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=
# Support email shown on the age stop and help screens.
EXPO_PUBLIC_SUPPORT_EMAIL=
# Cloudflare Turnstile (security round 1): the public site key. The secret key
# goes only in the Supabase dashboard (Auth → Bot protection), never here.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
# Hostname listed in the Turnstile site settings, used by the phone's widget.
EXPO_PUBLIC_TURNSTILE_BASE_URL=https://tapstrong.app/
# Local Supabase only (`supabase start`, captcha on like production, round 2
# S2-P2-6): Cloudflare's public always-pass test keys, documented at
# developers.cloudflare.com/turnstile/troubleshooting/testing/ — site key
# 1x00000000000000000000AA here, secret 1x0000000000000000000000000000000AA
# as SUPABASE_AUTH_CAPTCHA_SECRET in your shell. Never the real secret.
