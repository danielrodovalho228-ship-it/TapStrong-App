# Copy to .env and fill in. Never commit .env.
# Only EXPO_PUBLIC_* variables are bundled into the app. They must be public-safe.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side secrets are NOT set here. Store them as Supabase secrets:
#   npx supabase secrets set ANTHROPIC_API_KEY=...
# Optional: web domain for invite links (https://tapstrong.app once it is set up).
# Without it, invite links use the app scheme: tapstrong://r/CODE
EXPO_PUBLIC_SHARE_BASE_URL=
# RevenueCat PUBLIC SDK keys (Project settings → API keys → public app-specific keys).
# The secret key never goes here: it is a Supabase secret (REVENUECAT_SECRET_KEY).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# PostHog (product events) and Sentry (crashes): public keys only, both optional.
# Leave empty and nothing is sent. Nothing is ever sent from a child profile.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
# Support email shown on the age stop and help screens.
EXPO_PUBLIC_SUPPORT_EMAIL=
