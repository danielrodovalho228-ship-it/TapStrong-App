    "eas-build-pre-install": "node scripts/check-env.mjs --if-production",
    "web:headers": "node scripts/web-headers.mjs",
    "web:export": "npx expo export --platform web --output-dir dist && node scripts/web-headers.mjs dist && node scripts/security-check.mjs --bundle dist --no-history --offline",
